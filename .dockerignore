# ============================================================
#  Smart Inventory Management System — Root .dockerignore
# ============================================================

# ---------------------------
# Dependencies (reinstalled inside container)
# ---------------------------
**/node_modules/

# ---------------------------
# Environment files (injected at runtime)
# ---------------------------
**/.env
**/.env.*
!**/.env.example

# ---------------------------
# Build artefacts from host
# ---------------------------
**/dist/
**/build/
**/.next/

# ---------------------------
# Logs
# ---------------------------
**/*.log
**/logs/
npm-debug.log*
yarn-debug.log*

# ---------------------------
# Git
# ---------------------------
.git/
.gitignore
.gitattributes

# ---------------------------
# IDE / Editor
# ---------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------------------
# Testing & Coverage
# ---------------------------
**/coverage/
**/.nyc_output/

# ---------------------------
# OS artefacts
# ---------------------------
.DS_Store
Thumbs.db

# ---------------------------
# Docker files themselves
# ---------------------------
docker-compose*.yml
**/Dockerfile*
**/.dockerignore

# ---------------------------
# CI / CD
# ---------------------------
.github/
.gitlab-ci.yml

# ---------------------------
# Kubernetes
# ---------------------------
k8s/
*.yaml
*.yml
!**/package*.json

# ---------------------------
# Miscellaneous
# ---------------------------
README.md
*.md
*.tgz
*.tar.gz
.cache/
.temp/
tmp/
